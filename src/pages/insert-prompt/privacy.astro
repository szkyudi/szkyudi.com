    font-weight: bold;
    margin: 2rem 0 0.75rem;
  }
  p,
  ul {
    margin-bottom: 1rem;
  }
  ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  a {
    text-decoration: underline;
  }
</style>
